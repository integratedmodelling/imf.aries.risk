project private namespace aries.risk.flood.coastal.indicator
	using aries.risk.flood.coastal;
 
private model aries.risk.flood.coastal:FloodHazardMetric in m 
	observing 
		aries.risk.flood.coastal:FloodWaterDepth named flood_depth
	lookup (flood_depth, ?) into 
	    flood_depth   |	hazard   
---------------------------------------------------------------------
		<= 0          |    0,           
		0 to 1        |    0.2,      
        1 to 2        |    0.4,       
		2 to 3        |    0.6,           
		3 to 4        |    0.8,      
        > 4           |    1 ; 

model aries.risk.flood.coastal:FloodExposureMetric     
	observing 
		im:Normalized count of demography:HumanIndividual named normalized_population,
		im:Mean im:Area of infrastructure:Building named mean_area_of_residential_building_pambane
	set to [normalized_population * mean_area_of_residential_building_pambane]
	, klab.data.normalize();
	
model aries.risk.flood.coastal:FloodVulnerabilityMetric     
	observing 
		im:Gross economics:DomesticProduct named gdp,
		im:Mean im:Height of infrastructure:Building named mean_height_of_building_pambane	
	set to [
			def vul = (mean_height_of_building_pambane == 0 ? unknown : gdp * mean_height_of_building_pambane) 
			return vul
		],
	  	  klab.data.normalize()	  	   
	then [1 - self];
	
/* 
 * Ordered Weighted Averages (OWA)-based composite risk indicator
 */
@parameter(label = 'Risk aversion', default=0.5, name = risk_profile) 
@parameter(label = 'Risk neutral profile?', default=false, name = balanced_risk_prof)
@parameter(label = 'Ratio between median and extremes', default=1, name = ratio_balance)
model aries.risk.flood.coastal:FloodRiskMetric  
	observing 
	    @criterion(relweight ?= 2) aries.risk.flood.coastal:FloodHazardMetric,
	    @criterion(relweight ?= 1) aries.risk.flood.coastal:FloodExposureMetric,
	    @criterion(relweight ?= 2) aries.risk.flood.coastal:FloodVulnerabilityMetric   
    using im.mca.owa(interpolate_weights = false)
    , klab.data.normalize();
    
//project private model aries.risk.flood.coastal:FloodRiskMetric named flood_risk_metric_by_hand
//	observing 
//	    aries.risk.flood.coastal:FloodHazardMetric named hazard,
//	    aries.risk.flood.coastal:FloodExposureMetric named exposure,
//	    aries.risk.flood.coastal:FloodVulnerabilityMetric named vulnerability  
//    set to [(hazard + exposure + vulnerability)/3];
	    
 /*
  * MCA using the EVAMIX algorithm for spatially-explicit concordance metrics with
  * stakeholder prioritization
  */
 number mca_uhi_risk
  observing 
 	  @cost(value?=1) aries.risk.flood.coastal:FloodHazardMetric,
	  @cost(value?=1) aries.risk.flood.coastal:FloodExposureMetric,
	  @cost(value?=1) aries.risk.flood.coastal:FloodVulnerabilityMetric   
  using im.mca.concordance(levels = 10) 
  set to [1 - self ];
	    
@parameter(label = 'Risk threshold', default=0.5, name = risk_threshold)
project private model each earth:Location with im:Relevant aries.risk.flood.coastal:FloodRiskMetric named hotspots
	"Hotspots are identified by clustering the total risk index whose value lies above a chosen threshold."
	observing aries.risk.flood.coastal:FloodRiskMetric named risk
using     gis.points.cluster(select = [ risk > risk.max*1/5], minpoints = 3);	
//using gis.features.extract(select = [ hazard > 0 && hazard < 8], simplify = FALSE);
	
thing Hotspot equals earth:Location with im:Relevant aries.risk.flood.coastal:FloodRiskMetric;	
	
number gdp
	observing  
		im:Gross economics:DomesticProduct in USD@2005 by Hotspot
	set to [pop]; 

number pop
	observing  
		count of demography:HumanIndividual by Hotspot 
	set to [pop]; 

number value_buildings
	observing
		value of infrastructure:Building by Hotspot
	set to [value_building];

number cicco
observing  
count of demography:HumanIndividual by Hotspot 
set to [cicco]; 
