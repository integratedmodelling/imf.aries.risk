//model aries.risk.flood.coastal:FloodVulnerabilityMetric 
//  observing 
//    im:Normalized (im:Mean im:Height of infrastructure:Building) named normalized_height_of_building
//    set to [normalized_height_of_building]; 

	
model aries.risk.flood.coastal:FloodVulnerabilityMetric     
	observing 
		im:Gross economics:DomesticProduct named gdp,
		mean_residential_property_value_square_meter_pambane,
		mean_area_of_residential_building_pambane,
		mean_height_of_building_pambane
	set to [gdp * mean_residential_property_value_square_meter_pambane * 
			mean_area_of_residential_building_pambane * 
			mean_height_of_building_pambane]
	, klab.data.normalize();

