quantity InformVulnerabilityMetric
	describes risk:VulnerabilityMetric probability of im:Collapse of demography:SocialGroup;

quantity InformHazardMetric
	describes risk:HazardMetric probability of im:Collapse of demography:SocialGroup;
	
//quantity InformRiverFloodHazardMetric
//	describes risk:HazardMetric probability of im:Collapse of demography:SocialGroup;

project private model InformHazardMetric
	observing
		type of geography:Country named country
	lookup(country, ?, *, *) into HAZARD_EXPOSURE;
	
number river_flood_hazard
	observing
		type of geography:Country named country
	lookup(country, *, ?, *) into HAZARD_EXPOSURE;
	
number coastal_flood_hazard
	observing
		type of geography:Country named country
	lookup(country, *, *, ?) into HAZARD_EXPOSURE;
	