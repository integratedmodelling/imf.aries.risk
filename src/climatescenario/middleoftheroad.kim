scenario climatescenario.middleoftheroad
	"To use RCP4.5 and SSP5 data for Flood Depth and GDP"
	disjoint with climatescenario.highemissions
	using aries.risk.flood.coastal;
/*
 * The climate scenario MIDDLE OF THE ROAD includes
 * 		* Representative Concentration Pathway(RCP) 4.5
 * 			considered the intermediate scenario, 
 * 			with emissions peaking around 2040 and then declining
 * 		* Shared Socioeconomic Pathway(SSP) 2
 * 			a.k.a. "Middle of the road"
 * 			with social, economic and technological trends not shifting markedly 
 * 			from historical patterns
 */	

 /*
 * HAZARD
 * flood depth for future years 2030 and 2050
 */
model 	'local:caterina.gilli:imf.aries.risk:aries-risk.inuncoast_rcp4p5_wtsub_2030_rp0005_0',
		'local:caterina.gilli:imf.aries.risk:aries-risk.inuncoast_rcp4p5_wtsub_2050_rp0005_0'
	as aries.risk.flood.coastal:FloodWaterDepth in m;	

/*
 * EXPOSURE
 * population for future years 2050 and 2100
 */ 
// model 	'local:caterina.gilli:imf.aries.risk:aries-risk.totalpopulation_sedac_14km_2050_ssp2',
//		'local:caterina.gilli:imf.aries.risk:aries-risk.totalpopulation_sedac_14km_2100_ssp2'
//	as count of demography:HumanIndividual; 

/*
 * VULNERABILITY
 * GDP for future years 2030, 2050, 2100
 */ 
model 	'local:caterina.gilli:imf.aries.risk:aries-risk.gdp_wang_1km_2030_ssp2',
		'local:caterina.gilli:imf.aries.risk:aries-risk.gdp_wang_1km_2050_ssp2',
		'local:caterina.gilli:imf.aries.risk:aries-risk.gdp_wang_1km_2100_ssp2'
    as im:Gross economics:DomesticProduct in USD@2005;